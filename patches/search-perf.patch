+namespace {
+
+QHash<QString, QList<std::function<void()>>> & pendingIconRenders() {
+	static QHash<QString, QList<std::function<void()>>> map;
+	return map;
+}
+
+QImage renderIconImage(QSvgRenderer & renderer, const QSize & size, bool opaque) {
+	QImage image(size, QImage::Format_ARGB32_Premultiplied);
+	image.fill(opaque ? QColor(Qt::white) : QColor(Qt::transparent));
+	QSizeF def = renderer.defaultSize();
+	if (def.width() <= 0 || def.height() <= 0) return image;
+
+	double newW = size.width();
+	double newH = newW * def.height() / def.width();
+	if (newH > size.height()) {
+		newH = size.height();
+		newW = newH * def.width() / def.height();
+	}
+	QRectF bounds((size.width() - newW) / 2.0, (size.height() - newH) / 2.0, newW, newH);
+	QPainter painter(&image);
+	renderer.render(&painter, bounds);
+	return image;
+}
+
+class IconRenderTask : public QRunnable {
+public:
+	IconRenderTask(const QString & key, const QString & svgFilename) : m_key(key), m_svgFilename(svgFilename) {}
+
+	void run() override {
+		QByteArray bytes;
+		QFile file(m_svgFilename);
+		if (file.open(QIODevice::ReadOnly)) {
+			bytes = file.readAll();
+		}
+		QImage icon42;
+		QImage icon80;
+		if (!bytes.isEmpty()) {
+			QSvgRenderer renderer;
+			if (renderer.load(bytes)) {
+				icon42 = renderIconImage(renderer, QSize(42, 42), true);
+				icon80 = renderIconImage(renderer, QSize(80, 80), false);
+			}
+		}
+		const QString key = m_key;
+		QMetaObject::invokeMethod(QCoreApplication::instance(), [key, icon42, icon80]() {
+			QPixmap pixmap42(42, 42);
+			pixmap42.fill(Qt::white);
+			if (!icon42.isNull()) {
+				QPainter painter(&pixmap42);
+				painter.drawImage(0, 0, icon42);
+			}
+			QPixmap pixmap80(80, 80);
+			pixmap80.fill(Qt::transparent);
+			if (!icon80.isNull()) {
+				QPainter painter(&pixmap80);
+				painter.drawImage(0, 0, icon80);
+			}
+			PartsBinView::IconPixmapCache.insert(key, pixmap42);
+			PartsBinView::IconPixmapCache.insert(key + "80", pixmap80);
+			PartsBinView::finishIconRender(key);
+		}, Qt::QueuedConnection);
+	}
+
+private:
+	QString m_key;
+	QString m_svgFilename;
+};
+
+} // namespace
+
+void PartsBinView::renderIconAsync(const QString & moduleID, const QString & svgFilename, std::function<void()> onReady) {
+	const QString key = moduleID + "_icon";
+	if (!IconPixmapCache.value(key).isNull()) {
+		onReady();
+		return;
+	}
+	QList<std::function<void()>> & callbacks = pendingIconRenders()[key];
+	callbacks.append(onReady);
+	if (callbacks.count() > 1) {
+		return;
+	}
+	static QThreadPool * iconPool = nullptr;
+	if (iconPool == nullptr) {
+		iconPool = new QThreadPool();
+		iconPool->setMaxThreadCount(qBound(1, QThread::idealThreadCount(), 4));
+	}
+	iconPool->start(new IconRenderTask(key, svgFilename));
+}
+
+void PartsBinView::finishIconRender(const QString & key) {
+	auto it = pendingIconRenders().find(key);
+	if (it == pendingIconRenders().end()) return;
+	QList<std::function<void()>> callbacks = it.value();
+	pendingIconRenders().erase(it);
+	Q_FOREACH (const std::function<void()> & callback, callbacks) {
+		callback();
+	}
+}
