diff --git a/src/partsbinpalette/binmanager/binmanager.cpp b/src/partsbinpalette/binmanager/binmanager.cpp
index 29f4dd8..2a13001 100644
--- a/src/partsbinpalette/binmanager/binmanager.cpp
+++ b/src/partsbinpalette/binmanager/binmanager.cpp
@@ -979,9 +979,21 @@ void BinManager::search(const QString & searchText) {
 	}
 	QList<ModelPart *> modelParts = m_referenceModel->search(effectiveSearchText, allowObsolete);
 
-	progress.setIncValueMod(1);
+	// Broad queries (a single letter matches all bundled parts) used to create one widget
+	// per result; each add triggered a full flow-layout pass, freezing the UI for minutes.
+	// Cap the number of widgets and lay them out in one batch instead.
+	const int maxSearchResults = 300;
+	int displayed = 0;
+	bool truncated = false;
+
+	progress.setIncValueMod(10);
 	searchBin->removeParts();
+	searchBin->beginBulkAdd();
 	Q_FOREACH (ModelPart * modelPart, modelParts) {
+		if (displayed >= maxSearchResults) {
+			truncated = true;
+			break;
+		}
 		//DebugDialog::debug(modelPart->title());
 		if (modelPart->itemType() == ModelPart::SchematicSubpart) {
 		}
@@ -989,9 +1001,15 @@ void BinManager::search(const QString & searchText) {
 		}
 		else {
 			this->addPartTo(searchBin, modelPart, false);
+			displayed++;
 		}
 		progress.incValue();
 	}
+	searchBin->endBulkAdd();
+
+	if (truncated && m_mainWindow != nullptr) {
+		m_mainWindow->statusMessage(tr("Too many results; showing the first %1. Refine your search.").arg(maxSearchResults), 8000);
+	}
 
 	setDirtyTab(searchBin);
 }
